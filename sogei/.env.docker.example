# Credenziali per la build delle immagini (usate da create.ps1 / create.sh).
# Copiare in .env.docker e compilare. .env.docker NON va committato.

# Token GitHub (classic con scope "repo", o fine-grained con Contents: read
# sui repo PGKappa/sogei-*) usato da composer per scaricare i pacchetti privati.
GITHUB_TOKEN=

# Opzionali: se valorizzati viene eseguito "docker login" prima della build
# (utile per evitare i rate limit di Docker Hub).
DOCKER_USERNAME=
DOCKER_PASSWORD=
