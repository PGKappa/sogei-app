# File eseguiti/letti nei container Linux: sempre LF, anche con core.autocrlf=true su Windows
*.sh          text eol=lf
*.conf        text eol=lf
*.ini         text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
Dockerfile*   text eol=lf
**/rootfs/**          text eol=lf
**/rootfs-service/**  text eol=lf
**/etc/service/*/run  text eol=lf
